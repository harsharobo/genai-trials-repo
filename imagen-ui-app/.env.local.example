# Databricks Configuration
# Copy this file to .env.local and fill in your values

# Databricks CLI profile to use (default: DEFAULT)
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Workspace path where app files will be stored
# Example: /Workspace/Users/your.email@company.com/imagen-ui-app
WORKSPACE_SOURCE_PATH=/Workspace/Users/YOUR_EMAIL/imagen-ui-app

# Name of your Databricks App
DATABRICKS_APP_NAME=imagen-ui-app

# Model Endpoint Configuration
# URL of your Databricks Model Serving endpoint
MODEL_ENDPOINT_URL=https://your-workspace.cloud.databricks.com/serving-endpoints/your-endpoint/invocations

# Optional: Model endpoint token (can also be set as a Databricks secret)
# MODEL_ENDPOINT_TOKEN=dapi...

# Application Environment
ENV=production
